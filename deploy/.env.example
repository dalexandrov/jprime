# =====================================================================================================
# jPrime production settings - copy to .env (same directory) and fill in every "change-me".
# .env holds secrets: never commit it (it is in .gitignore). chmod 600 .env
# Generate random values with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# =====================================================================================================

# ---- Domains (DNS A/AAAA records must point at this server; ports 80/443 open) ----
SITE_DOMAIN=jprime.io
ADMIN_DOMAIN=admin.jprime.io
# Let's Encrypt account / expiry notices
ACME_EMAIL=conference@jprime.io
# Optional: restrict the admin domain to these IPs/CIDRs (space separated). Default: everyone
#ADMIN_ALLOWED_IPS=203.0.113.10/32 198.51.100.0/24

# ---- Database ----
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=jprime
MYSQL_PASSWORD=change-me

# ---- Secrets of the apps (>= 16 characters, different values!) ----
# Encrypt the login cookies. Changing them logs everybody out.
SITE_SESSION_KEY=change-me
ADMIN_SESSION_KEY=change-me
# Signs the captcha answer cookie
CAPTCHA_SECRET=change-me
# Password of the "admin" account - plain text or a BCrypt hash ($2a$...). In a BCrypt hash every "$" must be
# written as "$$" in this file, e.g.  ADMIN_PASSWORD=$$2a$$10$$abc...
ADMIN_PASSWORD=change-me
# Optional: comma separated e-mails of registered users that may also log into the admin
ADMIN_EMAILS=

# ---- Mail (SMTP over TLS) ----
MAIL_HOST=mail.jprime.io
MAIL_PORT=465
MAIL_USERNAME=conference@jprime.io
MAIL_FROM=conference@jprime.io
MAIL_PASSWORD=change-me
# Staging: send EVERY mail to this address instead of the real recipient
MAIL_TEST_ADDRESS=
# true = do not send at all, only log the mails
MAIL_MOCK=false

# ---- Payments (only if ePay online payments are re-enabled) ----
EPAY_KEY=

# ---- Backups (deploy/backups/) ----
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# ---- Resources ----
SITE_MEM_LIMIT=1g
ADMIN_MEM_LIMIT=1g
TZ=Europe/Sofia
